import logging
import time
import can
import j1939

logging.getLogger('j1939').setLevel(logging.INFO)
logging.getLogger('can').setLevel(logging.WARNING)


# -----------------------------
# DM1 CALLBACK (FULL DECODE)
# -----------------------------
def dm1_receive(priority, lamp_status, dtc_list, timestamp):
    print("\n🔥 DM1 RECEIVED")
    print(f"Priority: {priority} | Time: {timestamp}")

    # Lamp status decoding
    print("Lamp Status:")
    print(f"  MIL: {lamp_status.mil}")
    print(f"  RSL: {lamp_status.rsl}")
    print(f"  AWL: {lamp_status.awl}")
    print(f"  PL : {lamp_status.pl}")

    if not dtc_list:
        print("No active DTCs ✅")
        return

    print("\nActive DTCs:")
    for i, dtc in enumerate(dtc_list, 1):
        spn = dtc['spn']
        fmi = dtc['fmi']
        oc = dtc.get('oc', 0)

        print(f"  DTC {i}:")
        print(f"     SPN: {spn}")
        print(f"     FMI: {fmi}")
        print(f"     OC : {oc}")


# -----------------------------
# MAIN
# -----------------------------
def main():
    print("🚀 Initializing DM1 Reader (Vector + J1939)")

    ecu = j1939.ElectronicControlUnit()

    ecu.connect(
        bustype='vector',
        app_name='CANalyzer',
        channel=0,
        bitrate=250000
    )

    # -----------------------------
    # Controller Application
    # -----------------------------
    name = j1939.Name(
        arbitrary_address_capable=0,
        industry_group=j1939.Name.IndustryGroup.Industrial,
        vehicle_system_instance=1,
        vehicle_system=1,
        function=1,
        function_instance=1,
        ecu_instance=1,
        manufacturer_code=666,
        identity_number=1234567
    )

    ca = j1939.ControllerApplication(name, 0xF1)
    ecu.add_ca(controller_application=ca)

    # -----------------------------
    # DM1 Subscription (IMPORTANT)
    # -----------------------------
    dm1 = j1939.Dm1(ca)
    dm1.subscribe(dm1_receive)

    # OPTIONAL: Request DM1 (if ECU doesn't broadcast)
    # dm1.request()

    ca.start()

    print("📡 Listening for DM1 messages...")

    try:
        while True:
            time.sleep(1)

    except KeyboardInterrupt:
        print("\n🛑 Stopping...")

    finally:
        ca.stop()
        ecu.disconnect()


if __name__ == '__main__':
    main()
