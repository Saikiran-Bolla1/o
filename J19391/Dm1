import logging
import time
import j1939

logging.getLogger('j1939').setLevel(logging.INFO)
logging.getLogger('can').setLevel(logging.INFO)


def dm1_receive(priority, lamp_status, dtc_list, timestamp):
    print("\n===== DM1 Received =====")
    print(f"Priority: {priority}, Timestamp: {timestamp}")
    print(f"Lamp Status: {lamp_status}")

    if not dtc_list:
        print("No active DTCs")
        return

    for dtc in dtc_list:
        print(f"SPN: {dtc['spn']}, FMI: {dtc['fmi']}, OC: {dtc.get('oc', 0)}")


def main():
    print("Initializing DM1 Reader (Vector)")

    ecu = j1939.ElectronicControlUnit()

    ecu.connect(
        bustype='vector',
        app_name='CANalyzer',
        channel=0,
        bitrate=250000
    )

    name = j1939.Name(
        arbitrary_address_capable=1,
        industry_group=j1939.Name.IndustryGroup.Industrial,
        vehicle_system_instance=1,
        vehicle_system=1,
        function=1,
        function_instance=1,
        ecu_instance=1,
        manufacturer_code=666,
        identity_number=1234567
    )

    # Let stack choose address
    ca = j1939.ControllerApplication(name, None)
    ecu.add_ca(ca)

    dm1 = j1939.Dm1(ca)
    dm1.subscribe(dm1_receive)

    ca.start()

    print("Listening for DM1 messages for 120 seconds...")
    time.sleep(120)

    print("Stopping...")
    ca.stop()
    ecu.disconnect()


if __name__ == '__main__':
    main()
