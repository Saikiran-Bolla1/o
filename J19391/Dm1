import logging
import time
import can
import j1939

logging.getLogger('j1939').setLevel(logging.DEBUG)
logging.getLogger('can').setLevel(logging.DEBUG)


def dm1_receive(priority, lamp_status, dtc_list, timestamp):
    """Callback for receiving DM1 messages"""
    print(">>> DM1 CALLBACK TRIGGERED")
    print(f"DM1 Received - Priority: {priority}, Timestamp: {timestamp}")
    print(f"Lamp Status: {lamp_status}")
    print(f"Active DTCs: {dtc_list}")

    for dtc in dtc_list:
        print(f" SPN: {dtc['spn']}, FMI: {dtc['fmi']}, OC: {dtc.get('oc', 0)}")


def main():
    print("Initializing DM1 Reader with Vector CAN Driver")

    ecu = j1939.ElectronicControlUnit()

    # Connect using Vector CAN driver
    ecu.connect(
        bustype='vector',
        app_name='CANalyzer',
        channel=0,
        bitrate=250000
    )

    print("Connected to Vector CAN interface")

    # SMALL delay (important, no logic change)
    time.sleep(1)

    # Subscribe to all messages
    def on_message(priority, pgn, sa, timestamp, data):
        print(f"RX PGN: {hex(pgn)} from {hex(sa)}")

        if pgn == 0xFECA:  # DM1 PGN
            hex_data = ''.join(f'{byte:02x}' for byte in data)
            print(f"Raw DM1 PGN {hex(pgn)} from {hex(sa)}: {hex_data}")

    ecu.subscribe(on_message)

    # Create CA
    name = j1939.Name(
        arbitrary_address_capable=0,
        industry_group=j1939.Name.IndustryGroup.Industrial,
        vehicle_system_instance=1,
        vehicle_system=1,
        function=1,
        function_instance=1,
        ecu_instance=1,
        manufacturer_code=666,
        identity_number=1234567
    )

    ca = j1939.ControllerApplication(name, 0xF1)
    ecu.add_ca(controller_application=ca)

    # Subscribe to DM1 messages
    dm1 = j1939.Dm1(ca)
    dm1.subscribe(dm1_receive)

    ca.start()
    print("CA started")

    print("Listening for DM1 messages... (120 seconds)")
    time.sleep(120)

    print("Shutting down")
    ca.stop()
    ecu.disconnect()


if __name__ == '__main__':
    main()
