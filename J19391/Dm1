import time
import j1939


def dm1_receive(priority, lamp_status, dtc_list, timestamp):
    print("\nDM1 RECEIVED")
    print("Lamp:", lamp_status)
    print("DTCs:", dtc_list)


def main():
    ecu = j1939.ElectronicControlUnit()

    ecu.connect(
        bustype='vector',
        channel=0,
        bitrate=250000,
        app_name='CANalyzer'
    )

    name = j1939.Name(
        arbitrary_address_capable=1,
        manufacturer_code=666,
        identity_number=1234567
    )

    ca = j1939.ControllerApplication(name, None)
    ecu.add_ca(ca)

    dm1 = j1939.Dm1(ca)
    dm1.subscribe(dm1_receive)

    ca.start()

    print("Waiting for DM1...")
    time.sleep(120)

    ca.stop()
    ecu.disconnect()


if __name__ == "__main__":
    main()
