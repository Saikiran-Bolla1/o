    set_global_protocol(CANProtocol.NORMAL_CAN)
    # OR for J1939:
    # set_global_protocol(CANProtocol.J1939)

    # Initialize handler
    handler = CANMessageHandler(
        dbc_file="example.dbc",
        channel=0,
        bitrate=500000,
        protocol=CANProtocol.NORMAL_CAN
    )

    # Start receiving
    handler.start_receiving()

    # Send single message (send once)
    tx_id_1 = handler.send_by_id(
        msg_id=0x123,
        data=bytes([0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08])
    )

    # Send multiple messages simultaneously
    configs = [
        CANTXConfig(
            message_id=0x100,
            data=bytes([0x10, 0x20, 0x30, 0x40, 0x50, 0x60, 0x70, 0x80]),
            cyclic_time_ms=100  # 100ms cycle
        ),
        CANTXConfig(
            message_id=0x200,
            data=bytes([0xAA, 0xBB, 0xCC, 0xDD]),
            cyclic_time_ms=50  # 50ms cycle
        ),
        CANTXConfig(
            message_name="EngineStatus",
            data=bytes([0x11, 0x22, 0x33, 0x44]),
            cyclic_time_ms=200  # 200ms cycle
        )
    ]

    tx_ids = handler.send_multiple_messages(configs)
    print(f"Started TX with IDs: {tx_ids}")

    # Monitor reception with callback
    def message_callback(msg: CANRXMessage):
        print(f"\n[RX] {msg.message_name or f'0x{msg.message_id:X}'}")
        print(f"  Signals: {msg.signal_values}")
        print(f"  RX Time: {msg.rx_time}")

    handler.register_rx_callback(0x300, message_callback)

    # Let it run
    try:
        time.sleep(10)

        # Get latest messages
        latest = handler.get_latest_message(0x100)
        if latest:
            print(f"\nLatest message 0x100: {latest.signal_values}")

        # Get message history
        history = handler.get_message_history(0x100, count=5)
        print(f"Message history: {len(history)} messages")

        # Stop specific transmission
        handler.stop_transmission(tx_ids[0])

        # Get status
        status = handler.get_transmission_status()
        print(f"TX Status: {status}")

    except KeyboardInterrupt:
        print("\nShutting down...")
    finally:
        handler.shutdown()
