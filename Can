    # ================== Read Message Functions ==================
    
    def read_message_by_pgn(self, pgn: int, timeout: float = 1.0, 
                           specific_priority: Optional[int] = None, 
                           specific_source: Optional[int] = None) -> Optional[Dict[str, Any]]:
        """
        Read CAN message by PGN from bus
        Priority and Source address may vary - captures first matching message
        
        Args:
            pgn: Parameter Group Number to listen for
            timeout: Read timeout in seconds
            specific_priority: Filter by specific priority (optional)
            specific_source: Filter by specific source address (optional)
            
        Returns:
            Dictionary with message data or None
            {
                'pgn': pgn,
                'name': message_name,
                'frame_id': frame_id,
                'priority': priority,
                'source_address': source_address,
                'rx_time': datetime,
                'signals': {signal_name: value, ...}
            }
        """
        start_time = time.time()
        expected_messages = self.get_message_by_pgn(pgn)
        
        if not expected_messages:
            print(f"✗ PGN {hex(pgn)} not found in DBC")
            return None
        
        while time.time() - start_time < timeout:
            try:
                msg = self.bus.recv(timeout=0.1)
                if msg is None:
                    continue
                
                if self.is_j1939:
                    msg_pgn, msg_priority, msg_source = PGNDBC.extract_pgn_from_can_id(msg.arbitration_id)
                else:
                    msg_pgn = msg.arbitration_id
                    msg_priority = 0
                    msg_source = 0
                
                # Check if PGN matches
                if msg_pgn != pgn:
                    continue
                
                # Check optional filters
                if specific_priority is not None and msg_priority != specific_priority:
                    continue
                if specific_source is not None and msg_source != specific_source:
                    continue
                
                # Decode message
                try:
                    message = self.get_message_by_id(msg.arbitration_id)
                    if not message:
                        # Try to find any message with matching PGN
                        message = expected_messages[0]['message']
                    
                    decoded_signals = message.decode(msg.data)
                    
                    return {
                        'pgn': hex(pgn),
                        'name': message.name,
                        'frame_id': hex(msg.arbitration_id),
                        'priority': msg_priority if self.is_j1939 else 'N/A',
                        'source_address': msg_source if self.is_j1939 else 'N/A',
                        'rx_time': datetime.now(),
                        'signals': decoded_signals
                    }
                except Exception as e:
                    print(f"⚠️  Decode error: {e}")
                    continue
                    
            except Exception as e:
                continue
        
        return None
    
    def read_message_by_id(self, message_id: int, timeout: float = 1.0) -> Optional[Dict[str, Any]]:
        """
        Read CAN message by specific frame ID
        
        Args:
            message_id: CAN frame ID
            timeout: Read timeout in seconds
            
        Returns:
            Dictionary with message data or None
        """
        message = self.get_message_by_id(message_id)
        if not message:
            print(f"✗ Message ID {hex(message_id)} not found in DBC")
            return None
        
        if self.is_j1939:
            pgn, priority, source = PGNDBC.extract_pgn_from_can_id(message_id)
        else:
            pgn = message_id
            priority = 0
            source = 0
        
        start_time = time.time()
        while time.time() - start_time < timeout:
            try:
                msg = self.bus.recv(timeout=0.1)
                if msg is None:
                    continue
                
                # Check if frame ID matches exactly
                if msg.arbitration_id != message_id:
                    continue
                
                try:
                    decoded_signals = message.decode(msg.data)
                    
                    return {
                        'pgn': hex(pgn),
                        'name': message.name,
                        'frame_id': hex(message_id),
                        'priority': priority if self.is_j1939 else 'N/A',
                        'source_address': source if self.is_j1939 else 'N/A',
                        'rx_time': datetime.now(),
                        'signals': decoded_signals
                    }
                except Exception as e:
                    print(f"⚠️  Decode error: {e}")
                    continue
                    
            except Exception as e:
                continue
        
        return None
    
