        return None
    
    # ================== Read Signal Functions ==================
    
    def get_signal_value_by_pgn_and_signal(self, pgn: int, signal_name: str, 
                                          timeout: float = 1.0,
                                          specific_priority: Optional[int] = None,
                                          specific_source: Optional[int] = None) -> Optional[Tuple[Any, str, datetime, int, int]]:
        """
        Get specific signal value by PGN and signal name
        
        Args:
            pgn: Parameter Group Number
            signal_name: Signal name
            timeout: Read timeout in seconds
            specific_priority: Filter by specific priority (optional)
            specific_source: Filter by specific source address (optional)
            
        Returns:
            Tuple of (signal_value, unit, rx_time, priority, source_address) or None
        """
        msg_data = self.read_message_by_pgn(pgn, timeout, specific_priority, specific_source)
        if msg_data is None:
            print(f"✗ Failed to read PGN {hex(pgn)}")
            return None
        
        signals = msg_data['signals']
        if signal_name not in signals:
            print(f"✗ Signal '{signal_name}' not found in message")
            return None
        
        # Get signal unit
        message = self.get_message_by_id(int(msg_data['frame_id'], 16))
        signal = message.get_signal_by_name(signal_name)
        unit = signal.unit if signal else 'N/A'
        
        priority = msg_data['priority']
        source = msg_data['source_address']
        
        return signals[signal_name], unit, msg_data['rx_time'], priority, source
    
