"""
CAN/J1939 DBC Reader Module with PGN Support
Handles reading CAN messages using PGN (Parameter Group Number) from J1939 protocol
Priority and Source Address may vary - all matching messages are captured
"""

import can
import cantools
from datetime import datetime
from typing import Dict, List, Tuple, Optional, Any
import struct
import time


class PGNDBC:
    """
    Helper class to extract PGN information from CAN messages
    J1939 Frame Format: Priority (3 bits) | Reserved (1 bit) | Data Page (1 bit) | PDU Format (8 bits) | PDU Specific (8 bits) | Source Address (8 bits)
    """
    
    @staticmethod
    def extract_pgn_from_can_id(can_id: int) -> Tuple[int, int, int]:
        """
        Extract PGN, Priority, and Source Address from 29-bit CAN ID (J1939)
        
        Args:
            can_id: 29-bit CAN identifier
            
        Returns:
            Tuple of (pgn, priority, source_address)
        """
        priority = (can_id >> 26) & 0x07  # Bits 28-26
        reserved = (can_id >> 25) & 0x01  # Bit 25
        data_page = (can_id >> 24) & 0x01  # Bit 24
        pdu_format = (can_id >> 16) & 0xFF  # Bits 23-16
        pdu_specific = (can_id >> 8) & 0xFF  # Bits 15-8
        source_address = can_id & 0xFF  # Bits 7-0
        
        # PGN calculation
        if pdu_format < 240:  # PDU1 format
            pgn = (pdu_format << 8) | 0x00  # PS byte is 0 for PDU1
        else:  # PDU2 format
            pgn = (pdu_format << 8) | pdu_specific
        
        return pgn, priority, source_address
    
    @staticmethod
    def create_can_id_from_pgn(pgn: int, priority: int = 6, source_address: int = 0) -> int:
        """
        Create 29-bit CAN ID from PGN, Priority, and Source Address
        
        Args:
            pgn: Parameter Group Number
            priority: Priority (0-7, default 6)
            source_address: Source Address (0-255, default 0)
            
        Returns:
            29-bit CAN identifier
        """
        priority = priority & 0x07
        pdu_format = (pgn >> 8) & 0xFF
        pdu_specific = pgn & 0xFF
        source_address = source_address & 0xFF
        
        can_id = (priority << 26) | (0 << 25) | (0 << 24) | (pdu_format << 16) | (pdu_specific << 8) | source_address
        return can_id


class CANDBCReaderPGN:
    """
    CAN DBC Reader with PGN support for J1939 protocol
    Reads CAN messages using PGN and handles variable priority and source addresses
    """
    
    def __init__(self, dbc_file: str, channel: int = 0, bitrate: int = 500000, 
                 is_j1939: bool = True, interface: str = 'vector'):
        """
        Initialize CAN DBC Reader with PGN support
        
        Args:
            dbc_file: Path to DBC file
            channel: CAN channel (default 0)
            bitrate: CAN bitrate (default 500000)
            is_j1939: Enable J1939/PGN mode (default True)
            interface: CAN interface type (default 'vector')
        """
        try:
            self.db = cantools.database.load_file(dbc_file)
            print(f"✓ DBC file loaded: {dbc_file}")
        except Exception as e:
            print(f"✗ Failed to load DBC file: {e}")
            raise
        
        try:
            self.bus = can.Bus(interface=interface, channel=channel, bitrate=bitrate)
            print(f"✓ CAN bus initialized: {interface}, Channel: {channel}, Bitrate: {bitrate}")
        except Exception as e:
            print(f"✗ Failed to initialize CAN bus: {e}")
            raise
        
        self.is_j1939 = is_j1939
        self.pgn_to_messages = self._build_pgn_map()
    
    def _build_pgn_map(self) -> Dict[int, List[Dict[str, Any]]]:
        """
        Build a mapping of PGN to all matching messages in DBC
        
        Returns:
            Dictionary mapping PGN -> List of message info dicts
        """
        pgn_map = {}
        
        for message in self.db.messages:
            if self.is_j1939:
                # Extract PGN from message frame_id
                pgn, priority, source = PGNDBC.extract_pgn_from_can_id(message.frame_id)
            else:
                # For non-J1939, use frame_id as PGN
                pgn = message.frame_id
                priority = 0
                source = 0
            
            if pgn not in pgn_map:
                pgn_map[pgn] = []
            
            pgn_map[pgn].append({
                'message': message,
                'pgn': pgn,
                'priority': priority,
                'source_address': source,
                'frame_id': message.frame_id,
                'name': message.name
            })
        
        return pgn_map
    
    # ================== Message Lookup Functions ==================
    
    def get_message_by_pgn(self, pgn: int) -> List[Dict[str, Any]]:
        """
        Get all messages matching a PGN
        
        Args:
            pgn: Parameter Group Number
            
        Returns:
            List of message info dictionaries
        """
        return self.pgn_to_messages.get(pgn, [])
    
    def get_message_by_id(self, message_id: int) -> Optional[cantools.db.can.Message]:
        """
        Get message by CAN frame ID
        
        Args:
            message_id: CAN frame ID
            
        Returns:
            Message object or None
        """
        return self.db.get_message_by_frame_id(message_id)
    
    def get_message_by_name(self, message_name: str) -> Optional[cantools.db.can.Message]:
        """
        Get message by name
        
        Args:
            message_name: Message name
            
        Returns:
            Message object or None
        """
        try:
            return self.db.get_message_by_name(message_name)
        except KeyError:
            return None
    
    # ================== List/Print Functions ==================
    
    def list_all_messages(self) -> List[Dict[str, Any]]:
        """
        List all messages in DBC
        
        Returns:
            List of message dictionaries with PGN info
        """
        messages_list = []
        for message in self.db.messages:
            if self.is_j1939:
                pgn, priority, source = PGNDBC.extract_pgn_from_can_id(message.frame_id)
            else:
                pgn = message.frame_id
                priority = 0
                source = 0
            
            messages_list.append({
                'name': message.name,
                'frame_id': hex(message.frame_id),
                'pgn': hex(pgn) if self.is_j1939 else pgn,
                'priority': priority if self.is_j1939 else 'N/A',
                'source_address': source if self.is_j1939 else 'N/A',
                'dlc': message.length,
                'signals': len(message.signals)
            })
        return messages_list
    
