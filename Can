    # ================== Continuous Read Functions ==================
    
    def continuous_read_by_pgn(self, pgn: int, duration: float = 10.0,
                              specific_priority: Optional[int] = None,
                              specific_source: Optional[int] = None) -> List[Dict[str, Any]]:
        """
        Read CAN message by PGN continuously for specified duration
        Captures all messages with matching PGN (priority and source may vary)
        
        Args:
            pgn: Parameter Group Number
            duration: Duration in seconds
            specific_priority: Filter by specific priority (optional)
            specific_source: Filter by specific source address (optional)
            
        Returns:
            List of message dictionaries with timestamps
        """
        messages = []
        start_time = time.time()
        expected_messages = self.get_message_by_pgn(pgn)
        
        if not expected_messages:
            print(f"✗ PGN {hex(pgn)} not found in DBC")
            return messages
        
        print(f"📡 Reading PGN {hex(pgn)} for {duration} seconds...")
        
        while time.time() - start_time < duration:
            try:
                msg = self.bus.recv(timeout=0.1)
                if msg is None:
                    continue
                
                if self.is_j1939:
                    msg_pgn, msg_priority, msg_source = PGNDBC.extract_pgn_from_can_id(msg.arbitration_id)
                else:
                    msg_pgn = msg.arbitration_id
                    msg_priority = 0
                    msg_source = 0
                
                # Check if PGN matches
                if msg_pgn != pgn:
                    continue
                
                # Check optional filters
                if specific_priority is not None and msg_priority != specific_priority:
                    continue
                if specific_source is not None and msg_source != specific_source:
                    continue
                
                try:
                    message = self.get_message_by_id(msg.arbitration_id)
                    if not message:
                        message = expected_messages[0]['message']
                    
                    decoded_signals = message.decode(msg.data)
                    
                    messages.append({
                        'pgn': hex(pgn),
                        'name': message.name,
                        'frame_id': hex(msg.arbitration_id),
                        'priority': msg_priority if self.is_j1939 else 'N/A',
                        'source_address': msg_source if self.is_j1939 else 'N/A',
                        'rx_time': datetime.now(),
                        'signals': decoded_signals
                    })
                    print(f"✓ Received: {message.name} (Priority: {msg_priority}, Source: {msg_source})")
                    
                except Exception as e:
                    print(f"⚠️  Decode error: {e}")
                    continue
                    
            except Exception as e:
                continue
        
        print(f"📊 Captured {len(messages)} message(s)\n")
        return messages
    
