    def get_pgn_from_frame_id(self, frame_id: int) -> int:
        """
        Extract PGN from CAN frame ID
        
        Args:
            frame_id: CAN frame ID
            
        Returns:
            PGN value
        """
        if self.is_j1939:
            pgn, _, _ = PGNDBC.extract_pgn_from_can_id(frame_id)
            return pgn
        return frame_id
    
    def get_priority_from_frame_id(self, frame_id: int) -> int:
        """
        Extract Priority from CAN frame ID (J1939 only)
        
        Args:
            frame_id: CAN frame ID
            
        Returns:
            Priority value
        """
        if self.is_j1939:
            _, priority, _ = PGNDBC.extract_pgn_from_can_id(frame_id)
            return priority
        return 0
    
    def get_source_address_from_frame_id(self, frame_id: int) -> int:
        """
        Extract Source Address from CAN frame ID (J1939 only)
        
        Args:
            frame_id: CAN frame ID
            
        Returns:
            Source Address value
        """
        if self.is_j1939:
            _, _, source = PGNDBC.extract_pgn_from_can_id(frame_id)
            return source
        return 0
    
    def close(self):
        """Close CAN bus connection"""
        try:
            self.bus.shutdown()
            print("✓ CAN bus connection closed")
        except Exception as e:
            print(f"⚠️  Error closing CAN bus: {e}")


